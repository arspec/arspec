    ] ;
    ars:label "Holds" ;
    ars:maxCount 1 ;
    ars:minCount 1 ;
    ars:objectChoices [
        a ars:FilterCompare ;
        ars:left [
            a ars:TermValue ;
            ars:role rdf:predicate
        ] ;
        ars:op ars:eq ;
        ars:value [
            a ars:IriValue ;
            ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
            ars:localName "holds"
        ]
    ] ;
    ars:objectChoicesPart rdf:object ;
    ars:objectTypeConstraint ars:term ;
    ars:objectViewMode rdfs:label ;
    ars:objectVisible true ;
    ars:order 1 .

