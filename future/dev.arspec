# == Functions ==
#
# The instruction half: every ins:Function with the frame it takes and its
# body, which the Block service reads — and reads again under every Then,
# Else and Do, a block being the same thing wherever it hangs.

fn:perspec a ars:Perspective ;
    ars:description "Each function with the frame it takes and its body, instruction by instruction." ;
    ars:inLensList false ;
    ars:rootDataSource fn:ds_functions ;
    ars:title "Functions" .

fn:ds_functions a ars:DataSource ;
    ars:child fn:ds_label, fn:ds_takes, fn:ds_body ;
    ars:distinctBy rdf:subject ;
    ars:enableIf [
        a ars:FilterCompare ;
        ars:left [
            a ars:TermValue ;
            ars:role rdf:subject
        ] ;
        ars:op ars:typeIs ;
        ars:value [
            a ars:IriValue ;
            ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
            ars:localName "Function"
        ]
    ] ;
    ars:filter [
        a ars:FilterCompare ;
        ars:left [
            a ars:TermValue ;
            ars:role rdf:subject
        ] ;
        ars:op ars:typeIs ;
        ars:value [
            a ars:IriValue ;
            ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
            ars:localName "Function"
        ]
    ] ;
    ars:subjectOnClick ars:edit ;
    ars:subjectVisible true .

fn:ds_label a ars:DataSource, av:Compact ;
    ars:filter [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:TermValue ;
                ars:role rdf:subject ;
                ars:bindingDistance 1
            ] ;
            ars:order 0
        ], [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:predicate
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "http://www.w3.org/2000/01/rdf-schema#" ;
                ars:localName "label"
            ] ;
            ars:order 1
        ]
    ] ;
    ars:label "Name" ;
    ars:maxCount 1 ;
    ars:minCount 1 ;
    ars:objectTypeConstraint xsd:string ;
    ars:objectVisible true ;
    ars:order 0 .

fn:ds_takes a ars:DataSource, av:Compact ;
    ars:filter [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
            ars:op ars:eq ;
            ars:value [
