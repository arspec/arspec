            ] ;
            ars:order 1
        ]
    ] ;
    ars:label "Label" ;
    ars:maxCount 1 ;
    ars:minCount 1 ;
    ars:objectTypeConstraint xsd:string ;
    ars:objectVisible true ;
    ars:order 0 .

