fn:inv_block a ars:Invocation ;
    ars:objectParameter [
        a ars:BlankValue
    ] ;
    ars:order 0 ;
    ars:perspective blk:perspec ;
    ars:predicateParameter [
        a ars:BlankValue
    ] ;
    ars:subjectParameter [
        a ars:TermValue ;
        ars:role rdf:object ;
        ars:bindingDistance 1
    ] .


# == Block ==
#
# The instructions of the block a row is handed as its subject, in order.
# The list's own Add makes an instruction of no kind yet, numbered where it
# stands, and is kept to the menu and its key; the bar holds nine actions,
# one per kind, each of which calls that Add and then says of the row it
# made what kind it is and which parts it has, for the reader to fill. Each
# part is a section pinned to one predicate, standing only under the kinds
# that have it, and its editor offers what belongs there: a slot where a
# slot is named, the operators, the functions, the frames, the kinds — and
# takes nothing else, except for an operand, which may as well be a
# constant typed. Then, Else and Do run this perspective again on the block
# they name.

blk:perspec a ars:Perspective ;
    ars:description "The instructions of one block, in order, each with the parts its kind has — and under an If or a While, the blocks it runs." ;
    ars:inFileTabs false ;
    ars:inLensList false ;
    ars:rootDataSource blk:ds_steps ;
    ars:serviceOf fn:perspec ;
    ars:title "Block" .

