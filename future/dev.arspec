# == Vocabulary ==
#
# For the ontology itself: every class with what it is, the properties that
# name it as their domain, and its members where it has any.

voc:perspec a ars:Perspective ;
    ars:description "Each class with its comment, the properties it is the domain of, and its members." ;
    ars:inLensList false ;
    ars:rootDataSource voc:ds_classes ;
    ars:title "Vocabulary" .

voc:ds_classes a ars:DataSource ;
    ars:child voc:ds_label, voc:ds_kind_of, voc:ds_comment, voc:ds_properties, voc:ds_members ;
    ars:distinctBy rdf:subject ;
    ars:enableIf [
        a ars:FilterCompare ;
        ars:left [
            a ars:TermValue ;
            ars:role rdf:subject
        ] ;
        ars:op ars:typeIs ;
        ars:value [
            a ars:IriValue ;
            ars:nsUri "http://www.w3.org/2002/07/owl#" ;
            ars:localName "Class"
        ]
    ] ;
    ars:filter [
        a ars:FilterCompare ;
        ars:left [
            a ars:TermValue ;
            ars:role rdf:subject
        ] ;
        ars:op ars:typeIs ;
        ars:value [
            a ars:IriValue ;
            ars:nsUri "http://www.w3.org/2002/07/owl#" ;
            ars:localName "Class"
        ]
    ] ;
    ars:subjectOnClick ars:edit ;
    ars:subjectVisible true .

voc:ds_label a ars:DataSource, av:Compact ;
    ars:filter [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
