@prefix ars: <https://arspec.org/ars/spec/1/schema#> .
@prefix aset: <https://arspec.org/ars/app/1/config#> .
@prefix av: <https://arspec.org/ars/spec/1/schema/view#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fr: <https://arspec.org/ars/perspec/1/instruct_frames#> .
@prefix fn: <https://arspec.org/ars/perspec/1/instruct_functions#> .
@prefix blk: <https://arspec.org/ars/perspec/1/instruct_block#> .
@prefix voc: <https://arspec.org/ars/perspec/1/instruct_vocabulary#> .

[] a aset:Topic ;
    aset:sourceURI "instruct.ttl", "algorithms.ttl" ;
    aset:title "Programming ontology" .

[] a aset:FileSettings ;
    aset:fileName "instruct.ttl" .

# == Frames ==
#
# The state half of a program: every ins:Frame with its contract beneath it —
# where it stands, its slots in order with what each holds, owns and starts
# as — and then the same frame read from the other end: the functions that
# take it, the slots that hold it, the frames that stand within it.

fr:perspec a ars:Perspective ;
    ars:description "Each frame with its contract: the context it stands within, its slots in order, and who takes, holds and stands within it." ;
    ars:inLensList false ;
    ars:rootDataSource fr:ds_frames ;
    ars:title "Frames" .

fr:ds_frames a ars:DataSource ;
    ars:child fr:ds_label, fr:ds_within, fr:ds_slots, fr:ds_takers, fr:ds_holders, fr:ds_inside ;
    ars:distinctBy rdf:subject ;
    ars:enableIf [
        a ars:FilterCompare ;
        ars:left [
            a ars:TermValue ;
            ars:role rdf:subject
        ] ;
        ars:op ars:typeIs ;
        ars:value [
            a ars:IriValue ;
            ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
            ars:localName "Frame"
        ]
    ] ;
    ars:filter [
        a ars:FilterCompare ;
        ars:left [
            a ars:TermValue ;
            ars:role rdf:subject
        ] ;
        ars:op ars:typeIs ;
        ars:value [
            a ars:IriValue ;
            ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
            ars:localName "Frame"
        ]
    ] ;
    ars:subjectOnClick ars:edit ;
    ars:subjectVisible true .

fr:ds_label a ars:DataSource, av:Compact ;
    ars:filter [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:TermValue ;
                ars:role rdf:subject ;
                ars:bindingDistance 1
            ] ;
            ars:order 0
        ], [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:predicate
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "http://www.w3.org/2000/01/rdf-schema#" ;
                ars:localName "label"
            ] ;
            ars:order 1
        ]
    ] ;
    ars:label "Name" ;
    ars:maxCount 1 ;
    ars:minCount 1 ;
    ars:objectTypeConstraint xsd:string ;
    ars:objectVisible true ;
    ars:order 0 .

fr:ds_within a ars:DataSource, av:Compact ;
    ars:filter [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:TermValue ;
                ars:role rdf:subject ;
                ars:bindingDistance 1
            ] ;
            ars:order 0
        ], [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:predicate
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
                ars:localName "within"
            ] ;
            ars:order 1
        ]
    ] ;
    ars:label "Within" ;
    ars:maxCount 1 ;
    ars:objectChoices [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:predicate
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
                ars:localName "type"
            ] ;
            ars:order 0
        ], [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:object
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
                ars:localName "Frame"
            ] ;
            ars:order 1
        ]
    ] ;
    ars:objectChoicesOnly true ;
    ars:objectTypeConstraint ars:term ;
    ars:objectViewMode rdfs:label ;
    ars:objectVisible true ;
    ars:order 1 .

fr:ds_slots a ars:DataSource ;
    ars:child fr:ds_slot_label, fr:ds_slot_holds, fr:ds_slot_owns, fr:ds_slot_initially, fr:ds_slot_writer ;
    ars:filter [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:predicate
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
                ars:localName "of"
            ] ;
            ars:order 0
        ], [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:object
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:TermValue ;
                ars:role rdf:subject ;
                ars:bindingDistance 1
            ] ;
            ars:order 1
        ], [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
            ars:op ars:typeIs ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
                ars:localName "Slot"
            ] ;
            ars:order 2
        ]
    ] ;
    ars:label "Slots" ;
    ars:order 2 ;
    ars:orderQuery [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:TermValue ;
                ars:role rdf:subject ;
                ars:bindingDistance 1
            ] ;
            ars:order 0
        ], [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:predicate
            ] ;
            ars:op ars:eq ;
            ars:value [
                a ars:IriValue ;
                ars:nsUri "https://arspec.org/ars/spec/1/instruct#" ;
                ars:localName "order"
            ] ;
            ars:order 1
        ]
    ] ;
    ars:sortBy ars:order ;
    ars:subjectOnClick ars:edit ;
    ars:subjectVisible true .

