        ars:objectDefaultValue [
            a ars:IriValue ;
            ars:nsUri "http://www.w3.org/2001/XMLSchema#" ;
            ars:localName "integer"
        ]
    ] ;
    ars:filter [
        a ars:FilterAnd ;
        ars:operand [
            a ars:FilterCompare ;
            ars:left [
                a ars:TermValue ;
                ars:role rdf:subject
            ] ;
            ars:op ars:eq ;
